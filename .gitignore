# Віртуальне середовище (занадто важке, Render створить своє)
venv/
env/
.venv/

# Секретні ключі та паролі (НАЙВАЖЛИВІШЕ!)
.env
.env.*

# Кеш Python (зайве сміття)
__pycache__/
*.pyc
*.pyo
*.pyd

# Системні файли Mac/Windows
.DS_Store
Thumbs.db

# ---------------------------------------------------
# ДОДАТКОВІ (РЕКОМЕНДОВАНІ) НАЛАШТУВАННЯ
# ---------------------------------------------------

# Налаштування редакторів коду (VS Code, PyCharm)
.vscode/
.idea/

# Логи (щоб не пушити файли з помилками сервера)
*.log

# Папки з тимчасовими або тестовими файлами 
# (щоб випадково не залити свої файли з "Урології" чи "ЛОРу" на GitHub)
uploads/
temp/
test_files/
*.pdf
*.docx